    <string name="account_change_player_name_title">Change your Player Name</string>
    <string name="account_change_player_name_message">Here you can change your player name. The first time is free, otherwise, you must sacrifice some Gems.</string>
    <string name="account_change_player_name_hint">Enter your new Player Name</string>
    <string name="account_subscription_title">Seal of Njaga</string>
    <string name="account_subscription_info">As the chosen bearer of the Seal of the legendary Drakaina Njaga, you shall be granted entry to the entirety of the mystical realm of Morkahja. But beware, for this privilege comes at a cost. To obtain this rarity, you must offer up 42 precious gems. And remember, it will only remain in your possession if you continue to make this sacrifice every lunar cycle.</string>
    <string name="account_update_your_player_name">update your player name</string>
    <string name="account_verify_title">Verify your e-mail</string>
    <string name="account_security_title">Security</string>
    <string name="account_security_a">At <b>Morkahja</b>, the privacy and security of our users is our top priority. We understand the importance of keeping your personal information safe and secure, which is why we have implemented strict measures to ensure the protection of your data.</string>
    <string name="account_security_b">Reset your password</string>
    <string name="account_security_c">Sign Out</string>
    <string name="account_security_d">Delete Account and Data</string>
    <string name="account_subscription_a"><![CDATA[Yet, the rewards are boundless. With the Seal, you will gain unfettered rewards.<ul><li>Access to all expansions and rare encounters in Morkahja</li><li>Chance to find rare and powerful items that only a select few have ever laid eyes upon</li></ul>]]></string>
    <string name="account_subscription_title_b">Seal of Norghor</string>
    <string name="account_subscription_info_b">As the chosen one to hold the Seal of mighty Dragon Norghor, you shall be granted passage into the vast and mystical realm of Morkahja. But do not think this boon comes without a price. To attain this priceless artefact, you must part with 66 precious gems. And remember, to keep the Seal in your possession, you must offer up an equal sum every moon cycle.</string>
    <string name="account_subscription_b"><![CDATA[The rewards shall be beyond your wildest dreams. With the Seal of Norghor in hand, you shall gain unhindered freedom..<ul><li>Access to all expansions and rare encounters in Morkahja.</li><li>Chance to find rare and powerful items that only a select few have ever laid eyes upon.</li><li>Unlocks all portraits and frames, eliminating all other costs entirely.</li></ul>]]><p>No longer will you be held back by the restrictions of mere mortals, for you shall have become something far greater.</p></string>
