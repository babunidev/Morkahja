{
  "name": "morkahja",
  "author": "Babuni.dev",
  "version": "0.9.0-beta.2.2",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --prefix server",
    "dev:backend": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "start": "npm run start --prefix server",
    "verify:static-data": "node scripts/verify-static-game-data.mjs",
    "test:content-publication": "npm run test:content-publication --prefix server",
    "test:content-runtime": "npm run test:content-runtime --prefix server",
    "test:content-admin": "npm run test:content-admin --prefix server",
    "test:content-artwork": "npm run test:content-artwork --prefix server",
    "test:client-content": "npm run test:client-content --prefix server",
    "test:encounter": "npm run test:encounter --prefix server",
    "test:lifecycle": "npm run test:lifecycle --prefix server",
    "typecheck": "npm run typecheck --prefix shared && npm run typecheck --prefix server && npm run build --prefix client",
    "release:check": "npm run verify:static-data && npm run test:session-auth --prefix server && npm run test:achievements --prefix server && npm run test:dice --prefix server && npm run typecheck"
